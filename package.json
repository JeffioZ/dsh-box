{
  "name": "dsh-desktop",
  "version": "0.1.20",
  "private": true,
  "description": "DeepSeek Harness (dsh) desktop shell with tray and managed runtime updates",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
